diff --git a/node_modules/jsonresume-theme-professional/src/ui/Service.js b/node_modules/jsonresume-theme-professional/src/ui/Service.js
new file mode 100644
index 0000000..c931547
--- /dev/null
+++ b/node_modules/jsonresume-theme-professional/src/ui/Service.js
@@ -0,0 +1,38 @@
+import styled from 'styled-components';
+import Section from './Section';
+import { FaExternalLinkAlt } from 'react-icons/fa';
+
+const Item = styled.li`
+  margin-bottom: 3px;
+`;
+
+const Service = ({ volunteer }) => {
+  const items = (volunteer || []).filter((v) => v.service);
+  if (items.length === 0) {
+    return null;
+  }
+
+  return (
+    <div>
+      <Section title="Service">
+        <ul style={{ paddingLeft: 0, listStyle: 'none' }}>
+          {items.map((v, key) => (
+            <Item key={key}>
+              <strong>{v.position}:</strong>{' '}
+              {v.website ? (
+                <a href={v.website} style={{ color: 'inherit', textDecoration: 'none' }}>
+                  {v.organization}
+                  <FaExternalLinkAlt style={{ color: '#1f5fbf', width: '8px', height: '8px', marginLeft: '5px' }} />
+                </a>
+              ) : (
+                v.summary
+              )}
+            </Item>
+          ))}
+        </ul>
+      </Section>
+    </div>
+  );
+};
+
+export default Service;
